APP_NAME=Disposable L1
APP_BRAND=thaw.fun
APP_ENVIRONMENT=local
API_HOST=127.0.0.1
API_PORT=3000
CHAIN_REPOSITORY_PATH=.runtime/chains.json
# Absolute path to the Avalanche CLI base directory; defaults to ~/.avalanche-cli when unset.
# Must be paired with RUN_CLI_E2E=1 so the CLI's e2e root and this adapter read/write the same
# tree (demo scripts inject the pairing at runtime); mismatched pairing makes sidecar waits time out.
AVALANCHE_CLI_BASE_DIR=
SHIPFUN_API_HOST=127.0.0.1
SHIPFUN_API_PORT=3000
SHIPFUN_LOCAL_RPC_URL=
SHIPFUN_FUJI_RPC_URL=
SHIPFUN_MAINNET_RPC_URL=
SHIPFUN_FUJI_KEY_NAME=
SHIPFUN_FUJI_P_ADDRESS=
SHIPFUN_FUJI_C_ADDRESS=
# Explicit public P-Chain budget thresholds, chosen in the user-approved mutation preview.
SHIPFUN_FUJI_MAX_P_GAS_PRICE_NAVAX=
SHIPFUN_FUJI_MIN_P_BALANCE_NAVAX=
# All Fuji artifact paths below must be absolute; keep the encrypted probe keystore outside this repository.
SHIPFUN_FUJI_REPOSITORY_PATH=
SHIPFUN_FUJI_AVALANCHEGO_BIN=
SHIPFUN_FUJI_SUBNET_EVM_BIN=
SHIPFUN_FUJI_PUBLIC_IP=
SHIPFUN_FUJI_HOST_CONTROL_EXECUTABLE=
SHIPFUN_FUJI_NODE_ADDRESS=127.0.0.1:9650
SHIPFUN_FUJI_RPC_BASE_URL=http://127.0.0.1:9650
SHIPFUN_FUJI_GENESIS_PATH=
SHIPFUN_FUJI_OFFICIAL_GENESIS_SOURCE_PATH=
SHIPFUN_FUJI_GENESIS_MANIFEST_PATH=
SHIPFUN_FUJI_GENESIS_OUTPUT_DIR=
SHIPFUN_FUJI_VALIDATOR_MANAGER_ADDRESS=
SHIPFUN_FUJI_PROBE_ADDRESS=
SHIPFUN_FUJI_PROBE_KEYSTORE=
# Pin to official icm-contracts commit 0b68b03c906d17850712b49aa20f2dc18ed55568.
SHIPFUN_FUJI_ICM_CONTRACTS_PATH=
# Absolute path to official solc 0.8.25, SHA-256 cc3f94a70ac681b0304084acc1980aabe2a1bb3240d44ce76a8df0e1e77a2110.
SHIPFUN_FUJI_SOLC_PATH=
# Loopback-only signature aggregator; never a remote signing/key service.
SHIPFUN_FUJI_SIG_AGG_URL=
FORGE_PATH=
SHIPFUN_FUJI_INTERACTIVE_SIGNING=false
SHIPFUN_FUJI_MUTATION_APPROVED=false
SHIPFUN_MAINNET_KEY_NAME=
SHIPFUN_MAINNET_CONFIRM=
