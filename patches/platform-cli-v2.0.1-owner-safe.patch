+++ b/cmd/validators_spec_test.go
@@ -29,6 +29,28 @@ func newTestPoP(t *testing.T) *signer.ProofOfPossession {
 	return pop
 }
 
+func TestSetConversionValidatorOwners(t *testing.T) {
+	owner := ids.GenerateTestShortID()
+	validators := []*txs.ConvertSubnetToL1Validator{{}, {}}
+	if err := setConversionValidatorOwners(validators, owner); err != nil {
+		t.Fatal(err)
+	}
+	for i, validator := range validators {
+		if validator.RemainingBalanceOwner.Threshold != 1 || !reflect.DeepEqual(validator.RemainingBalanceOwner.Addresses, []ids.ShortID{owner}) {
+			t.Fatalf("validator %d remaining balance owner is not the signer", i)
+		}
+		if validator.DeactivationOwner.Threshold != 1 || !reflect.DeepEqual(validator.DeactivationOwner.Addresses, []ids.ShortID{owner}) {
+			t.Fatalf("validator %d deactivation owner is not the signer", i)
+		}
+	}
+	if err := setConversionValidatorOwners(validators, ids.ShortID{}); err == nil {
+		t.Fatal("expected empty owner to fail")
+	}
+	if err := setConversionValidatorOwners([]*txs.ConvertSubnetToL1Validator{nil}, owner); err == nil {
+		t.Fatal("expected nil validator to fail")
+	}
+}
