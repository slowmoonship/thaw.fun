diff --git a/cmd/validators_spec.go b/cmd/validators_spec.go
index 7106f60..f58b3af 100644
--- a/cmd/validators_spec.go
+++ b/cmd/validators_spec.go
@@ -27,6 +27,25 @@ import (
 
 const defaultValidatorWeight uint64 = 100
 
+// setConversionValidatorOwners keeps the remaining balance and the right to
+// deactivate each initial L1 validator under the P-Chain wallet that signs the
+// conversion. Both fields are otherwise left empty by the upstream CLI.
+func setConversionValidatorOwners(validators []*txs.ConvertSubnetToL1Validator, owner ids.ShortID) error {
+	if owner == (ids.ShortID{}) {
+		return fmt.Errorf("conversion validator owner must not be empty")
+	}
+	for i, validator := range validators {
+		if validator == nil {
+			return fmt.Errorf("conversion validator %d is nil", i)
+		}
+		validator.RemainingBalanceOwner.Threshold = 1
+		validator.RemainingBalanceOwner.Addresses = []ids.ShortID{owner}
+		validator.DeactivationOwner.Threshold = 1
+		validator.DeactivationOwner.Addresses = []ids.ShortID{owner}
+	}
+	return nil
+}
